# Copy this to `.env` in /opt/suethemchickens on the production server (never commit
# the real file — it holds real secrets). docker-compose.prod.yml reads it automatically
# via Docker Compose's built-in .env support.

# Real Postgres password for the production DB. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Admin portal (/admin) shared-secret token — sent as the x-admin-token header.
# Unset disables the admin API entirely (fails closed). Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# Which image tag to run. The deploy workflow overrides this per-deploy with the exact
# commit SHA that was just built; leave as `latest` for manual `docker compose pull`.
IMAGE_TAG=latest
