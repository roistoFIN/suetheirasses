# Server URL
VITE_SERVER_URL=http://localhost:3001

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX) — leave unset until the AdSense
# account is approved. The ad script never loads without it, regardless of consent.
VITE_ADSENSE_CLIENT_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) — leave unset until a GA4 property
# exists. The gtag.js script never loads without it, regardless of consent.
VITE_GA_MEASUREMENT_ID=
